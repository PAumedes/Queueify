<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Queueify.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand accent (the violet from the icon) instead of the Windows accent color. -->
            <Color x:Key="SystemAccentColor">#7B5CFF</Color>
            <Color x:Key="SystemAccentColorLight1">#9479FF</Color>
            <Color x:Key="SystemAccentColorLight2">#AE98FF</Color>
            <Color x:Key="SystemAccentColorLight3">#CBBBFF</Color>
            <Color x:Key="SystemAccentColorDark1">#6544E6</Color>
            <Color x:Key="SystemAccentColorDark2">#5030C4</Color>
            <Color x:Key="SystemAccentColorDark3">#3B1F9C</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
