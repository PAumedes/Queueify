<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Queueify</RootNamespace>
    <AssemblyName>Queueify</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Builds resources.pri with the compiled XAML in it, which unpackaged publish needs (and single-file requires). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Not Queueify.pri: WinUI looks for <exe name>.pri or resources.pri, and the download is called
         Queueify-X.Y.Z-win-x64.exe (or "Queueify (1).exe" when downloaded twice). -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Queueify.ico</ApplicationIcon>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- The download: one Queueify.exe, trimmed to the code the app uses. See ADR-0007. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Inside the dlls, so crash.log stack traces keep file and line. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Queueify.ico;Assets\Queueify.svg;Assets\Queueify-64.png;Assets\Queueify-256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Only WinUI and what it needs; the Microsoft.WindowsAppSDK metapackage adds ~60 MB of AI, ML,
         search and widgets the app doesn't use. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Queueify.Core\Queueify.Core.csproj" />
  </ItemGroup>
</Project>
