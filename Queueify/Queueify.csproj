<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Queueify</RootNamespace>
    <AssemblyName>Queueify</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Builds resources.pri with the compiled XAML in it, which unpackaged publish needs. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Not Queueify.pri: WinUI looks for <exe name>.pri or resources.pri, whatever the exe is called. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Queueify.ico</ApplicationIcon>
    <Version>1.5.0</Version>
  </PropertyGroup>

  <!-- Compiled ahead of time to native code, so no .NET runtime ships with it; tools\package.ps1 then
       packs the published folder into the single download exe (Queueify.Launcher). See ADR-0008. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- The symbols would be a separate 50 MB file; crash.log still names the methods. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The WinRT interop code WinUI needs is generated at build time (required for AOT); for lists it
         needs unsafe code, and without it the generator silently skips them. -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Queueify.ico;Assets\Queueify.svg;Assets\Queueify-64.png;Assets\Queueify-256.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Only WinUI and what it needs; the Microsoft.WindowsAppSDK metapackage adds ~60 MB of AI, ML,
         search and widgets the app doesn't use. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Queueify.Core\Queueify.Core.csproj" />
  </ItemGroup>
</Project>
