<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Queueify.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Queueify"
    xmlns:models="using:Queueify.Models"
    xmlns:services="using:Queueify.Services"
    xmlns:controls="using:Queueify.Controls"
    Title="Queueify">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnPhotoDragOver" Drop="OnPhotoDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusFilter" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnTogglePaneShortcut" />
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteShortcut" />
            <KeyboardAccelerator Key="F1" Invoked="OnHelpShortcut" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,1,7,2" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="CheckCircle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <Style x:Key="CheckCircleDone" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="17" />
            </Style>

            <!-- Card used by the Help page sections -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!-- Settings: one row per option, and the bold title above each group -->
            <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
            <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,18,0,4" />
            </Style>

            <!-- Round number used in the quick guide steps -->
            <Style x:Key="StepNumber" TargetType="Border">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>

            <!-- Search result: one row per album, merged across Spotify and Tidal -->
            <DataTemplate x:Key="ResultTemplate" x:DataType="models:AlbumResult">
                <Grid Padding="4,8" ColumnSpacing="12" Background="Transparent" DoubleTapped="OnResultDoubleTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="6" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image Source="{x:Bind l:Covers.From(CoverUrl)}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                            <Border Style="{StaticResource Pill}" Opacity="{x:Bind SpotifyOpacity}">
                                <TextBlock Text="Spotify" FontSize="11" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Opacity="{x:Bind TidalOpacity}">
                                <TextBlock Text="Tidal" FontSize="11" />
                            </Border>
                            <TextBlock Text="{x:Bind ScoreText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Tag="{x:Bind}" Click="OnAddResult" Visibility="{x:Bind CanAdd}"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="{l:Tr Key=result.add.name}" ToolTipService.ToolTip="{l:Tr Key=result.add.tip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="{l:Tr Key=result.add}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="2" Text="{x:Bind QueueState}" Visibility="{x:Bind HasQueueState}"
                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- Queue, list view -->
            <DataTemplate x:Key="ItemRowTemplate" x:DataType="models:BacklogItem">
                <Grid Padding="4,8" ColumnSpacing="14" Background="Transparent" Tag="{x:Bind}" DoubleTapped="OnItemDoubleTapped">
                    <Grid.ContextFlyout>
                        <MenuFlyout Opening="OnItemMenuOpening" />
                    </Grid.ContextFlyout>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Button Tag="{x:Bind}" Click="OnToggleListened" Style="{StaticResource CheckCircle}"
                                Visibility="{x:Bind IsPending}"
                                AutomationProperties.Name="{l:Tr Key=item.mark_listened}" ToolTipService.ToolTip="{l:Tr Key=item.mark_listened}">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        </Button>
                        <Button Tag="{x:Bind}" Click="OnToggleListened" Style="{StaticResource CheckCircleDone}"
                                Visibility="{x:Bind IsListened}"
                                AutomationProperties.Name="{l:Tr Key=item.move_back}" ToolTipService.ToolTip="{l:Tr Key=item.move_back}">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Border Grid.Column="1" Width="64" Height="64" CornerRadius="6"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image Source="{x:Bind l:Covers.From(CoverUrl), Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Album}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ArtistLine}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Tag before Value so a recycled row never saves its rating onto the previous album. -->
                        <RatingControl Tag="{x:Bind}" Value="{x:Bind Rating, Mode=OneWay}" ValueChanged="OnRatingChanged"
                                       Visibility="{x:Bind IsListened}" IsClearEnabled="True" VerticalAlignment="Center"
                                       AutomationProperties.Name="{l:Tr Key=item.rating}" />
                        <Button Tag="{x:Bind}" Click="OnPlay" IsEnabled="{x:Bind CanPlay}"
                                AutomationProperties.Name="{l:Tr Key=item.play}" ToolTipService.ToolTip="{l:Tr Key=item.play.tip}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                <TextBlock Text="{x:Bind PlayLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Tag="{x:Bind}" Width="36" Padding="0" Height="32"
                                AutomationProperties.Name="{l:Tr Key=item.more}" ToolTipService.ToolTip="{l:Tr Key=item.more.tip}">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout Opening="OnItemMenuOpening" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Queue, cover view -->
            <DataTemplate x:Key="ItemTileTemplate" x:DataType="models:BacklogItem">
                <Grid Width="176" Tag="{x:Bind}" Background="Transparent" DoubleTapped="OnItemDoubleTapped" RowSpacing="6" Padding="0,0,0,6">
                    <Grid.ContextFlyout>
                        <MenuFlyout Opening="OnItemMenuOpening" />
                    </Grid.ContextFlyout>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="176" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image Source="{x:Bind l:Covers.From(CoverUrl), Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <Grid Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Button Tag="{x:Bind}" Click="OnToggleListened" Style="{StaticResource CheckCircle}"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Visibility="{x:Bind IsPending}"
                                AutomationProperties.Name="{l:Tr Key=item.mark_listened}" ToolTipService.ToolTip="{l:Tr Key=item.mark_listened}">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        </Button>
                        <Button Tag="{x:Bind}" Click="OnToggleListened" Style="{StaticResource CheckCircleDone}"
                                Visibility="{x:Bind IsListened}"
                                AutomationProperties.Name="{l:Tr Key=item.move_back}" ToolTipService.ToolTip="{l:Tr Key=item.move_back}">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button Tag="{x:Bind}" Click="OnPlay" IsEnabled="{x:Bind CanPlay}" Style="{StaticResource AccentButtonStyle}"
                            Width="44" Height="44" CornerRadius="22" Padding="0" Margin="8"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            AutomationProperties.Name="{l:Tr Key=item.play}" ToolTipService.ToolTip="{x:Bind PlayLabel}">
                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <StackPanel Grid.Row="1" Spacing="1" Padding="2,0">
                        <TextBlock Text="{x:Bind Album}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ArtistLine}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- A line read from a magazine photo: a tinted box over the text, a button so it works by
                 keyboard and screen reader too. Background and border come from code (the accent colour). -->
            <Style x:Key="PhotoLineButton" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Highlight.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Highlight.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border x:Name="Highlight" Background="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compiled bindings, not DisplayMemberPath: the app is trimmed and compiled ahead of time. -->
            <DataTemplate x:Key="CountryItem" x:DataType="services:CountryOption">
                <TextBlock Text="{x:Bind Name}" />
            </DataTemplate>
            <DataTemplate x:Key="OcrLanguageItem" x:DataType="services:OcrLanguageOption">
                <TextBlock Text="{x:Bind Name}" />
            </DataTemplate>

            <DataTemplate x:Key="ShortcutTemplate" x:DataType="services:Shortcut">
                <Grid ColumnSpacing="16" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind Keys}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{x:Bind Description}" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag area): vector logo + name -->
        <Grid x:Name="AppTitleBar" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Queueify.svg" Width="20" Height="20" />
                <TextBlock Text="Queueify" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="220" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnNavSelectionChanged" ItemInvoked="OnNavItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="QueueNav" Content="{l:Tr Key=nav.queue}" Tag="queue" IsSelected="True"
                                    ToolTipService.ToolTip="{l:Tr Key=nav.queue.tip}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="QueueBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ListenedNav" Content="{l:Tr Key=nav.listened}" Tag="listened"
                                    ToolTipService.ToolTip="{l:Tr Key=nav.listened.tip}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE930;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ListenedBadge" Visibility="Collapsed" Style="{ThemeResource InformationalValueInfoBadgeStyle}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PhotoNav" Content="{l:Tr Key=nav.photo}" Tag="photo"
                                    ToolTipService.ToolTip="{l:Tr Key=nav.photo.tip}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="HelpNav" Content="{l:Tr Key=nav.help}" Tag="help" ToolTipService.ToolTip="{l:Tr Key=nav.help.tip}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SyncNav" Content="{l:Tr Key=nav.sync}" Tag="sync" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="SyncIcon" Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNav" Content="{l:Tr Key=nav.settings}" Tag="settings"
                                    ToolTipService.ToolTip="{l:Tr Key=nav.settings.tip}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneColumn" Width="420" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═════════ Add albums ═════════ -->
                <Border x:Name="AddPane" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid Padding="16,14,16,12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="{l:Tr Key=pane.title}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Click="OnHidePane" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="{l:Tr Key=pane.hide}" ToolTipService.ToolTip="{l:Tr Key=pane.hide.tip}">
                                <FontIcon Glyph="&#xE76B;" FontSize="14" />
                            </Button>
                        </Grid>

                        <InfoBar x:Name="SetupInfo" Grid.Row="1" Severity="Informational" IsClosable="False"
                                 Title="{l:Tr Key=pane.setup.title}"
                                 Message="{l:Tr Key=pane.setup.text}">
                            <InfoBar.ActionButton>
                                <Button Content="{l:Tr Key=pane.setup.open}" Click="OnSettings" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <TextBox x:Name="SearchBox" Grid.Row="2" Header="{l:Tr Key=pane.search}" MaxLength="300"
                                 PlaceholderText="{l:Tr Key=pane.search.placeholder}"
                                 TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown" />

                        <StackPanel Grid.Row="3" Spacing="4">
                            <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Visibility="Collapsed" />
                            <TextBlock x:Name="SearchStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton x:Name="AddWithoutLink" Visibility="Collapsed" Click="OnAddWithoutLink" Padding="0,2" />
                        </StackPanel>

                        <TextBox x:Name="SourceBox" Grid.Row="4" Header="{l:Tr Key=pane.magazine}" MaxLength="200"
                                 PlaceholderText="{l:Tr Key=pane.magazine.placeholder}">
                            <TextBox.Description>
                                <TextBlock Text="{l:Tr Key=pane.magazine.help}"
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBox.Description>
                        </TextBox>

                        <ListView x:Name="ResultsList" Grid.Row="5" ItemTemplate="{StaticResource ResultTemplate}"
                                  SelectionMode="Single" Margin="-8,0" />

                        <!-- Three-step how-to while nothing is being searched -->
                        <StackPanel x:Name="SearchTips" Grid.Row="5" Spacing="16" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="{l:Tr Key=pane.how}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="{l:Tr Key=pane.how.1a}" /><Run Text="Enter" FontWeight="SemiBold" /><Run Text="." /></TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="{l:Tr Key=pane.how.2a}" /><Run Text="Enter" FontWeight="SemiBold" /><Run Text="{l:Tr Key=pane.how.2b}" /></TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{l:Tr Key=pane.how.3}" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="{l:Tr Key=pane.keys}" />
                    </Grid>
                </Border>

                <!-- The hidden panel leaves this rail in its place: one click (or Ctrl+B) brings it back. -->
                <Button x:Name="PaneRail" Visibility="Collapsed" Click="OnShowPane"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                        Padding="0,14" CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        AutomationProperties.Name="{l:Tr Key=pane.show}"
                        ToolTipService.ToolTip="{l:Tr Key=pane.show.tip}">
                    <StackPanel Spacing="16">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <!-- Canvas: the rotated label must not be clipped by the narrow column. Left-aligned
                             text starts at the top after rotating; the box leaves room for large text sizes. -->
                        <Canvas Width="20" Height="240">
                            <TextBlock Text="{l:Tr Key=pane.title}" Width="240" TextAlignment="Left" FontWeight="SemiBold"
                                       Canvas.Left="-110" Canvas.Top="110" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </StackPanel>
                </Button>

                <controls:PaneSplitter x:Name="Splitter" Grid.Column="1" />

                <!-- ═════════ Pages ═════════ -->
                <Grid Grid.Column="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page header: icon, bold title, one-line summary -->
                    <Grid ColumnSpacing="14" Padding="4,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon x:Name="PageIcon" Glyph="&#xE8D6;" FontSize="30" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" AutomationProperties.AutomationId="PageTitle"
                                       Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Text="{l:Tr Key=nav.queue}" />
                            <TextBlock x:Name="PageSummary" AutomationProperties.AutomationId="PageSummary"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <!-- A newer version: offered here, under the title of every page, until it's installed or
                             closed. A row of its own, so it never squeezes the title on a narrow window. -->
                        <InfoBar x:Name="UpdateBar" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                 AutomationProperties.AutomationId="UpdateBar" />
                    </Grid>

                    <!-- Toolbar for the queue pages: labeled commands, like UniGetUI -->
                    <CommandBar x:Name="QueueCommands" Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" IsDynamicOverflowEnabled="True" Background="Transparent">
                        <CommandBar.Content>
                            <TextBox x:Name="FilterBox" Width="260" Margin="4,6,0,0" PlaceholderText="{l:Tr Key=queue.filter.placeholder}"
                                     TextChanged="OnFilterChanged" AutomationProperties.Name="{l:Tr Key=queue.filter}" />
                        </CommandBar.Content>
                        <AppBarButton x:Name="SurpriseButton" Label="{l:Tr Key=queue.surprise}" Click="OnSurprise"
                                      ToolTipService.ToolTip="{l:Tr Key=queue.surprise.tip}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8B1;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Name="SortButton" Label="{l:Tr Key=sort.oldest}" ToolTipService.ToolTip="{l:Tr Key=sort.tip}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8CB;" />
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <RadioMenuFlyoutItem x:Name="SortOldest" Text="{l:Tr Key=sort.oldest}" GroupName="sort" Tag="oldest" Click="OnSortChosen" />
                                    <RadioMenuFlyoutItem x:Name="SortNewest" Text="{l:Tr Key=sort.newest}" GroupName="sort" Tag="newest" Click="OnSortChosen" />
                                    <RadioMenuFlyoutItem x:Name="SortArtist" Text="{l:Tr Key=sort.artist}" GroupName="sort" Tag="artist" Click="OnSortChosen" />
                                    <RadioMenuFlyoutItem x:Name="SortYear" Text="{l:Tr Key=sort.year}" GroupName="sort" Tag="year" Click="OnSortChosen" />
                                    <RadioMenuFlyoutItem x:Name="SortSource" Text="{l:Tr Key=sort.magazine}" GroupName="sort" Tag="source" Click="OnSortChosen" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarToggleButton x:Name="CoverViewToggle" Label="{l:Tr Key=queue.covers}" Click="OnCoverViewToggled"
                                            ToolTipService.ToolTip="{l:Tr Key=queue.covers.tip}">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xF0E2;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                    </CommandBar>

                    <!-- Toolbar for the photo page -->
                    <CommandBar x:Name="PhotoCommands" Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left"
                                Visibility="Collapsed" Background="Transparent">
                        <AppBarButton Label="{l:Tr Key=photo.open}" Click="OnOpenPhoto" ToolTipService.ToolTip="{l:Tr Key=photo.open.tip}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="{l:Tr Key=photo.paste}" Click="OnPastePhoto" ToolTipService.ToolTip="{l:Tr Key=photo.paste.tip}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE77F;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton Label="{l:Tr Key=photo.fit}" Click="OnFitPhoto" ToolTipService.ToolTip="{l:Tr Key=photo.fit.tip}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE9A6;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <!-- Queue -->
                    <Border x:Name="QueuePanel" Grid.Row="2" CornerRadius="8" BorderThickness="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <ListView x:Name="QueueList" ItemTemplate="{StaticResource ItemRowTemplate}" SelectionMode="Single" Padding="8" />
                            <GridView x:Name="QueueGrid" ItemTemplate="{StaticResource ItemTileTemplate}" SelectionMode="Single"
                                      Padding="16,12" Visibility="Collapsed" />
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380">
                                <FontIcon x:Name="EmptyIcon" Glyph="&#xE8D6;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                                <TextBlock x:Name="EmptyText" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Magazine photo -->
                    <Grid x:Name="PhotoPanel" Grid.Row="2" RowSpacing="8" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <InfoBar x:Name="OcrInfo" IsClosable="True" />
                        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <ScrollViewer x:Name="PhotoScroller" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="4"
                                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Image x:Name="PhotoImage" Stretch="Fill" />
                                        <Canvas x:Name="LineCanvas" />
                                    </Grid>
                                </ScrollViewer>
                                <StackPanel x:Name="PhotoHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
                                    <FontIcon Glyph="&#xE722;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{l:Tr Key=photo.hint.title}" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{l:Tr Key=photo.hint.text}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Help -->
                    <ScrollViewer x:Name="HelpPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Padding="4,8,16,8">
                        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{l:Tr Key=help.guide}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.guide.1}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.guide.2}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.guide.3}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.guide.4}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.guide.5}" />
                                    <Button x:Name="ReplayTourButton" Content="{l:Tr Key=help.replay}" Click="OnReplayTour" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{l:Tr Key=help.shortcuts}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <ItemsControl x:Name="ShortcutList" ItemTemplate="{StaticResource ShortcutTemplate}" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{l:Tr Key=help.mouse}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{l:Tr Key=sync.title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.sync.1}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.sync.2}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{l:Tr Key=help.trouble}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.trouble.1}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.trouble.2}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.trouble.3}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.trouble.4}" />
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr Key=help.trouble.5}" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/Queueify.svg" Width="72" Height="72" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{l:Tr Key=help.about}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="AboutVersion" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AboutTagline" TextWrapping="Wrap" />
                                        <ItemsControl x:Name="AboutCredits" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <Button x:Name="CheckUpdatesButton" Content="{l:Tr Key=update.check}" Click="OnCheckForUpdates"
                                                    AutomationProperties.AutomationId="CheckUpdatesButton" />
                                            <Button Content="{l:Tr Key=help.data}" Click="OnOpenDataFolder"
                                                    ToolTipService.ToolTip="{l:Tr Key=help.data.tip}" />
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="UpdateStatus"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock x:Name="AboutDataPath" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings: sections of cards, like Windows Settings -->
                    <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Padding="4,8,16,8">
                        <!-- A star column with a maximum keeps the cards left-aligned under the page title. -->
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="1000" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{l:Tr Key=settings.music}" Style="{StaticResource SettingsSection}" Margin="0,0,0,4" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"
                                       Text="{l:Tr Key=settings.music.text}" />
                            <controls:ServiceCard x:Name="TidalCard" Service="Tidal" DashboardUrl="https://developer.tidal.com/dashboard"
                                                  Steps="{l:Tr Key=settings.tidal.steps}"
                                                  SaveRequested="OnSaveServiceKeys" RemoveRequested="OnRemoveServiceKeys" />
                            <controls:ServiceCard x:Name="SpotifyCard" Service="Spotify" DashboardUrl="https://developer.spotify.com/dashboard"
                                                  Steps="{l:Tr Key=settings.spotify.steps}"
                                                  SaveRequested="OnSaveServiceKeys" RemoveRequested="OnRemoveServiceKeys" />

                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE768;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr Key=settings.preferred}" />
                                        <TextBlock Text="{l:Tr Key=settings.preferred.text}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="PreferredBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="PreferredBox" AutomationProperties.Name="{l:Tr Key=settings.preferred}"
                                              SelectionChanged="OnPreferredChanged">
                                        <x:String>Tidal</x:String>
                                        <x:String>Spotify</x:String>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE909;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr Key=settings.country}" />
                                        <TextBlock Text="{l:Tr Key=settings.country.text}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CountryBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                              ItemTemplate="{StaticResource CountryItem}" MaxDropDownHeight="420"
                                              AutomationProperties.AutomationId="CountryBox" AutomationProperties.Name="{l:Tr Key=settings.country}"
                                              SelectionChanged="OnCountryChanged" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{l:Tr Key=settings.ocr}" Style="{StaticResource SettingsSection}" />
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8D2;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr Key=settings.ocr.read}" />
                                        <TextBlock Text="{l:Tr Key=settings.ocr.read.text}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="OcrLanguageBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                              ItemTemplate="{StaticResource OcrLanguageItem}"
                                              AutomationProperties.AutomationId="OcrLanguageBox" AutomationProperties.Name="{l:Tr Key=settings.ocr.read}"
                                              SelectionChanged="OnOcrLanguageChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=settings.ocr.installed}" />
                                        <TextBlock x:Name="OcrInstalledList" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="OcrInstalledList"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="2" Content="{l:Tr Key=settings.ocr.windows}" Click="OnOpenWindowsLanguages"
                                                     VerticalAlignment="Center"
                                                     ToolTipService.ToolTip="{l:Tr Key=settings.ocr.windows.tip}" />

                                    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{l:Tr Key=settings.ocr.add}" />
                                        <TextBlock Text="{l:Tr Key=settings.ocr.add.text}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox x:Name="OcrInstallBox" MinWidth="200" ItemTemplate="{StaticResource OcrLanguageItem}"
                                                  AutomationProperties.AutomationId="OcrInstallBox" AutomationProperties.Name="{l:Tr Key=settings.ocr.add.name}" />
                                        <Button x:Name="OcrInstallButton" Content="{l:Tr Key=settings.ocr.install}" Click="OnInstallOcrLanguage"
                                                AutomationProperties.AutomationId="OcrInstallButton" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="6">
                                        <ProgressBar x:Name="OcrInstallProgress" IsIndeterminate="True" Visibility="Collapsed" />
                                        <InfoBar x:Name="OcrInstallInfo" IsClosable="True" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{l:Tr Key=settings.appearance}" Style="{StaticResource SettingsSection}" />
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr Key=settings.theme}" />
                                        <TextBlock Text="{l:Tr Key=settings.theme.text}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="ThemeBox" AutomationProperties.Name="{l:Tr Key=settings.theme}"
                                              SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="{l:Tr Key=settings.theme.system}" Tag="system" />
                                        <ComboBoxItem Content="{l:Tr Key=settings.theme.light}" Tag="light" />
                                        <ComboBoxItem Content="{l:Tr Key=settings.theme.dark}" Tag="dark" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <FontIcon Glyph="&#xF2B7;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr Key=settings.language}" />
                                        <TextBlock Text="{l:Tr Key=settings.language.text}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="LanguageBox" AutomationProperties.Name="{l:Tr Key=settings.language}"
                                              SelectionChanged="OnLanguageChanged">
                                        <ComboBoxItem Content="{l:Tr Key=settings.language.system}" Tag="system" />
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Español" Tag="es" />
                                    </ComboBox>
                                    <InfoBar x:Name="LanguageRestartInfo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                             Severity="Informational" IsClosable="False" Message="{l:Tr Key=settings.language.restart}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE737;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr Key=settings.layout}" />
                                        <TextBlock Text="{l:Tr Key=settings.layout.text}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{l:Tr Key=settings.layout.reset}" Click="OnResetLayout" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{l:Tr Key=settings.updates}" Style="{StaticResource SettingsSection}" />
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE896;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr Key=settings.updates.auto}" />
                                        <TextBlock Text="{l:Tr Key=settings.updates.auto.text}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="UpdateCheckToggle" Grid.Column="2" VerticalAlignment="Center" MinWidth="0"
                                                  OnContent="" OffContent="" Toggled="OnUpdateCheckToggled"
                                                  AutomationProperties.AutomationId="UpdateCheckToggle"
                                                  AutomationProperties.Name="{l:Tr Key=settings.updates.auto}" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{l:Tr Key=sync.title}" Style="{StaticResource SettingsSection}" />
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="SettingsSyncIcon" Glyph="&#xE895;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Google Firebase" />
                                        <TextBlock x:Name="SettingsSyncStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{l:Tr Key=settings.sync.open}" Click="OnSync" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                                <TextBlock x:Name="SettingsDataPath" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                <HyperlinkButton Content="{l:Tr Key=help.data}" Click="OnOpenDataFolder" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Toast with Undo -->
                    <InfoBar x:Name="Toast" Grid.Row="2" IsClosable="True" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                             MaxWidth="620" Margin="0,0,0,16" Severity="Success" />
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Quick tour: one tip that moves from control to control -->
        <TeachingTip x:Name="Tour" Grid.Row="1" IsLightDismissEnabled="False" PreferredPlacement="Auto"
                     ActionButtonContent="{l:Tr Key=tour.next}" CloseButtonContent="{l:Tr Key=tour.skip}"
                     ActionButtonClick="OnTourNext" CloseButtonClick="OnTourClosed" />
    </Grid>
</Window>
