<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Queueify.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Queueify.Models"
    xmlns:services="using:Queueify.Services"
    xmlns:controls="using:Queueify.Controls"
    Title="Queueify">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="OnPhotoDragOver" Drop="OnPhotoDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnFocusSearch" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFocusFilter" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="OnTogglePaneShortcut" />
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="OnPasteShortcut" />
            <KeyboardAccelerator Key="F1" Invoked="OnHelpShortcut" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,1,7,2" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="CheckCircle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <Style x:Key="CheckCircleDone" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="17" />
            </Style>

            <!-- Card used by the Help page sections -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!-- Settings: one row per option, and the bold title above each group -->
            <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
            <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,18,0,4" />
            </Style>

            <!-- Round number used in the quick guide steps -->
            <Style x:Key="StepNumber" TargetType="Border">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>

            <!-- Search result: one row per album, merged across Spotify and Tidal -->
            <DataTemplate x:Key="ResultTemplate" x:DataType="models:AlbumResult">
                <Grid Padding="4,8" ColumnSpacing="12" Background="Transparent" DoubleTapped="OnResultDoubleTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="6" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                            <Border Style="{StaticResource Pill}" Opacity="{x:Bind SpotifyOpacity}">
                                <TextBlock Text="Spotify" FontSize="11" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Opacity="{x:Bind TidalOpacity}">
                                <TextBlock Text="Tidal" FontSize="11" />
                            </Border>
                            <TextBlock Text="{x:Bind ScoreText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Tag="{x:Bind}" Click="OnAddResult" Visibility="{x:Bind CanAdd}"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="Add to your queue" ToolTipService.ToolTip="Add to your queue (Enter)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="2" Text="{x:Bind QueueState}" Visibility="{x:Bind HasQueueState}"
                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- Queue, list view -->
            <DataTemplate x:Key="ItemRowTemplate" x:DataType="models:BacklogItem">
                <Grid Padding="4,8" ColumnSpacing="14" Background="Transparent" Tag="{x:Bind}" DoubleTapped="OnItemDoubleTapped">
                    <Grid.ContextFlyout>
                        <MenuFlyout Opening="OnItemMenuOpening" />
                    </Grid.ContextFlyout>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Center">
                        <Button Tag="{x:Bind}" Click="OnToggleListened" Style="{StaticResource CheckCircle}"
                                Visibility="{x:Bind IsPending}"
                                AutomationProperties.Name="Mark as listened" ToolTipService.ToolTip="Mark as listened">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        </Button>
                        <Button Tag="{x:Bind}" Click="OnToggleListened" Style="{StaticResource CheckCircleDone}"
                                Visibility="{x:Bind IsListened}"
                                AutomationProperties.Name="Move back to your queue" ToolTipService.ToolTip="Move back to your queue">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Border Grid.Column="1" Width="64" Height="64" CornerRadius="6"
                            Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind Album}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ArtistLine}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Tag before Value so a recycled row never saves its rating onto the previous album. -->
                        <RatingControl Tag="{x:Bind}" Value="{x:Bind Rating, Mode=OneWay}" ValueChanged="OnRatingChanged"
                                       Visibility="{x:Bind IsListened}" IsClearEnabled="True" VerticalAlignment="Center"
                                       AutomationProperties.Name="Your rating" />
                        <Button Tag="{x:Bind}" Click="OnPlay" IsEnabled="{x:Bind CanPlay}"
                                AutomationProperties.Name="Play" ToolTipService.ToolTip="Open the album to listen (double-click works too)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                <TextBlock Text="{x:Bind PlayLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Tag="{x:Bind}" Width="36" Padding="0" Height="32"
                                AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions (right-click works too)">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout Opening="OnItemMenuOpening" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Queue, cover view -->
            <DataTemplate x:Key="ItemTileTemplate" x:DataType="models:BacklogItem">
                <Grid Width="176" Tag="{x:Bind}" Background="Transparent" DoubleTapped="OnItemDoubleTapped" RowSpacing="6" Padding="0,0,0,6">
                    <Grid.ContextFlyout>
                        <MenuFlyout Opening="OnItemMenuOpening" />
                    </Grid.ContextFlyout>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="176" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="8" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <Grid Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Button Tag="{x:Bind}" Click="OnToggleListened" Style="{StaticResource CheckCircle}"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Visibility="{x:Bind IsPending}"
                                AutomationProperties.Name="Mark as listened" ToolTipService.ToolTip="Mark as listened">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        </Button>
                        <Button Tag="{x:Bind}" Click="OnToggleListened" Style="{StaticResource CheckCircleDone}"
                                Visibility="{x:Bind IsListened}"
                                AutomationProperties.Name="Move back to your queue" ToolTipService.ToolTip="Move back to your queue">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button Tag="{x:Bind}" Click="OnPlay" IsEnabled="{x:Bind CanPlay}" Style="{StaticResource AccentButtonStyle}"
                            Width="44" Height="44" CornerRadius="22" Padding="0" Margin="8"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            AutomationProperties.Name="Play" ToolTipService.ToolTip="{x:Bind PlayLabel}">
                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <StackPanel Grid.Row="1" Spacing="1" Padding="2,0">
                        <TextBlock Text="{x:Bind Album}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ArtistLine}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ShortcutTemplate" x:DataType="services:Shortcut">
                <Grid ColumnSpacing="16" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind Keys}" FontWeight="SemiBold" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{x:Bind Description}" TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drag area): vector logo + name -->
        <Grid x:Name="AppTitleBar" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Queueify.svg" Width="20" Height="20" />
                <TextBlock Text="Queueify" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" OpenPaneLength="220" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnNavSelectionChanged" ItemInvoked="OnNavItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="QueueNav" Content="To listen" Tag="queue" IsSelected="True"
                                    ToolTipService.ToolTip="To listen: albums waiting for you">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="QueueBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ListenedNav" Content="Listened" Tag="listened"
                                    ToolTipService.ToolTip="Listened: albums you've heard, with your ratings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE930;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="ListenedBadge" Visibility="Collapsed" Style="{ThemeResource InformationalValueInfoBadgeStyle}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PhotoNav" Content="Magazine photo" Tag="photo"
                                    ToolTipService.ToolTip="Magazine photo: click albums on a photo of the page">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="HelpNav" Content="Help" Tag="help" ToolTipService.ToolTip="Help, shortcuts and about (F1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SyncNav" Content="Sync" Tag="sync" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="SyncIcon" Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNav" Content="Settings" Tag="settings"
                                    ToolTipService.ToolTip="Settings: Tidal and Spotify, country, theme, layout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PaneColumn" Width="420" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═════════ Add albums ═════════ -->
                <Border x:Name="AddPane" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid Padding="16,14,16,12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="Add albums" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Click="OnHidePane" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="Hide this panel" ToolTipService.ToolTip="Hide this panel (Ctrl+B)">
                                <FontIcon Glyph="&#xE76B;" FontSize="14" />
                            </Button>
                        </Grid>

                        <InfoBar x:Name="SetupInfo" Grid.Row="1" Severity="Informational" IsClosable="False"
                                 Title="Connect Spotify and Tidal"
                                 Message="Paste your free developer keys once so Queueify can search their catalogs.">
                            <InfoBar.ActionButton>
                                <Button Content="Open settings" Click="OnSettings" />
                            </InfoBar.ActionButton>
                        </InfoBar>

                        <TextBox x:Name="SourceBox" Grid.Row="2" Header="Magazine" MaxLength="200"
                                 PlaceholderText="e.g. Rolling Stone #45">
                            <TextBox.Description>
                                <TextBlock Text="Optional. Saved with every album you add, so you remember where it came from."
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </TextBox.Description>
                        </TextBox>

                        <TextBox x:Name="SearchBox" Grid.Row="3" Header="Find an album" MaxLength="300"
                                 PlaceholderText="Artist and album, e.g. Charly García Clics Modernos"
                                 TextChanged="OnSearchTextChanged" PreviewKeyDown="OnSearchKeyDown" />

                        <StackPanel Grid.Row="4" Spacing="4">
                            <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Visibility="Collapsed" />
                            <TextBlock x:Name="SearchStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton x:Name="AddWithoutLink" Visibility="Collapsed" Click="OnAddWithoutLink" Padding="0,2" />
                        </StackPanel>

                        <ListView x:Name="ResultsList" Grid.Row="5" ItemTemplate="{StaticResource ResultTemplate}"
                                  SelectionMode="Single" Margin="-8,0" />

                        <!-- Three-step how-to while nothing is being searched -->
                        <StackPanel x:Name="SearchTips" Grid.Row="5" Spacing="16" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock Text="How it works" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="Type what the magazine says and press " /><Run Text="Enter" FontWeight="SemiBold" /><Run Text="." /></TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="The best match from Spotify and Tidal is highlighted. Press " /><Run Text="Enter" FontWeight="SemiBold" /><Run Text=" again to add it." /></TextBlock>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumber}">
                                    <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="When you've listened, tick the circle next to the album. Too lazy to type? Drop a photo of the page into the window." />
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="Enter search / add  ·  ↑ ↓ choose  ·  Esc clear  ·  F1 help" />
                    </Grid>
                </Border>

                <!-- The hidden panel leaves this rail in its place: one click (or Ctrl+B) brings it back. -->
                <Button x:Name="PaneRail" Visibility="Collapsed" Click="OnShowPane"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                        Padding="0,14" CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        AutomationProperties.Name="Show the Add albums panel"
                        ToolTipService.ToolTip="Show the Add albums panel (Ctrl+B)">
                    <StackPanel Spacing="16">
                        <FontIcon Glyph="&#xE76C;" FontSize="14" />
                        <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <!-- Canvas: the rotated label must not be clipped by the narrow column. Left-aligned
                             text starts at the top after rotating; the box leaves room for large text sizes. -->
                        <Canvas Width="20" Height="240">
                            <TextBlock Text="Add albums" Width="240" TextAlignment="Left" FontWeight="SemiBold"
                                       Canvas.Left="-110" Canvas.Top="110" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </StackPanel>
                </Button>

                <controls:PaneSplitter x:Name="Splitter" Grid.Column="1" />

                <!-- ═════════ Pages ═════════ -->
                <Grid Grid.Column="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Page header: icon, bold title, one-line summary -->
                    <Grid ColumnSpacing="14" Padding="4,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="PageIcon" Glyph="&#xE8D6;" FontSize="30" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" AutomationProperties.AutomationId="PageTitle"
                                       Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Text="To listen" />
                            <TextBlock x:Name="PageSummary" AutomationProperties.AutomationId="PageSummary"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Toolbar for the queue pages: labeled commands, like UniGetUI -->
                    <CommandBar x:Name="QueueCommands" Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" IsDynamicOverflowEnabled="True" Background="Transparent">
                        <CommandBar.Content>
                            <TextBox x:Name="FilterBox" Width="260" Margin="4,6,0,0" PlaceholderText="Filter (Ctrl+F)"
                                     TextChanged="OnFilterChanged" AutomationProperties.Name="Filter the queue" />
                        </CommandBar.Content>
                        <AppBarButton x:Name="SurpriseButton" Label="Surprise me" Click="OnSurprise"
                                      ToolTipService.ToolTip="Pick a random album to listen to">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8B1;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Name="SortButton" Label="Oldest first" ToolTipService.ToolTip="Order by">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8CB;" />
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <RadioMenuFlyoutItem x:Name="SortOldest" Text="Oldest first" GroupName="sort" Tag="oldest" Click="OnSortChosen" />
                                    <RadioMenuFlyoutItem x:Name="SortNewest" Text="Newest first" GroupName="sort" Tag="newest" Click="OnSortChosen" />
                                    <RadioMenuFlyoutItem x:Name="SortArtist" Text="Artist A–Z" GroupName="sort" Tag="artist" Click="OnSortChosen" />
                                    <RadioMenuFlyoutItem x:Name="SortYear" Text="Release year" GroupName="sort" Tag="year" Click="OnSortChosen" />
                                    <RadioMenuFlyoutItem x:Name="SortSource" Text="Magazine" GroupName="sort" Tag="source" Click="OnSortChosen" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarToggleButton x:Name="CoverViewToggle" Label="Cover view" Click="OnCoverViewToggled"
                                            ToolTipService.ToolTip="Show album covers in a grid">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xF0E2;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                    </CommandBar>

                    <!-- Toolbar for the photo page -->
                    <CommandBar x:Name="PhotoCommands" Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left"
                                Visibility="Collapsed" Background="Transparent">
                        <AppBarButton Label="Open photo…" Click="OnOpenPhoto" ToolTipService.ToolTip="Open a photo of a magazine page">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Paste" Click="OnPastePhoto" ToolTipService.ToolTip="Paste an image (Ctrl+V)">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE77F;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton Label="Fit to window" Click="OnFitPhoto" ToolTipService.ToolTip="Fit the page to the window (Ctrl+scroll zooms)">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE9A6;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <!-- Queue -->
                    <Border x:Name="QueuePanel" Grid.Row="2" CornerRadius="8" BorderThickness="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <ListView x:Name="QueueList" ItemTemplate="{StaticResource ItemRowTemplate}" SelectionMode="Single" Padding="8" />
                            <GridView x:Name="QueueGrid" ItemTemplate="{StaticResource ItemTileTemplate}" SelectionMode="Single"
                                      Padding="16,12" Visibility="Collapsed" />
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380">
                                <FontIcon x:Name="EmptyIcon" Glyph="&#xE8D6;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                                <TextBlock x:Name="EmptyText" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Magazine photo -->
                    <Grid x:Name="PhotoPanel" Grid.Row="2" RowSpacing="8" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <InfoBar x:Name="OcrInfo" IsClosable="True" />
                        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <ScrollViewer x:Name="PhotoScroller" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="4"
                                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Image x:Name="PhotoImage" Stretch="Fill" />
                                        <Canvas x:Name="LineCanvas" />
                                    </Grid>
                                </ScrollViewer>
                                <StackPanel x:Name="PhotoHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
                                    <FontIcon Glyph="&#xE722;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="Drop a photo of the page" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Take it with your phone, send it to the PC, and drop it anywhere in this window, paste it with Ctrl+V, or use Open photo." />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Help -->
                    <ScrollViewer x:Name="HelpPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Padding="4,8,16,8">
                        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Quick guide" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Text="1.  Type the artist and album from the magazine in “Find an album” and press Enter. Queueify searches Spotify and Tidal together and highlights the best match; Enter again adds it. The year can be off by one." />
                                    <TextBlock TextWrapping="Wrap" Text="2.  Write the magazine and issue in “Magazine” once; every album you add remembers where it came from." />
                                    <TextBlock TextWrapping="Wrap" Text="3.  When you want to listen, press Play (or double-click the album) and it opens in Tidal or Spotify. Choose which one in Settings." />
                                    <TextBlock TextWrapping="Wrap" Text="4.  Tick the circle when you've heard it. It moves to Listened, where you can give it stars. Changed your mind? Every action has Undo." />
                                    <TextBlock TextWrapping="Wrap" Text="5.  Lazy mode: photograph a page, drop the photo into the window, then click the artist and the album on it instead of typing." />
                                    <Button x:Name="ReplayTourButton" Content="Replay the quick tour" Click="OnReplayTour" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <ItemsControl x:Name="ShortcutList" ItemTemplate="{StaticResource ShortcutTemplate}" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Mouse: double-click an album to play it, right-click for more, drag the edge of the Add albums panel to resize it." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Sync between your PCs" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Text="Click Sync in the bar on the left. On the first PC you connect a free Google Firebase project (the dialog lists the steps); you then get a sync code. On other PCs, copy the whole Queueify folder, or open Sync and paste the code. Albums and your Spotify/Tidal keys come along." />
                                    <TextBlock TextWrapping="Wrap" Text="The Sync icon shows the state: a cloud when everything is up to date, a warning when something failed. Point at it to see why. Changes are never lost: they upload the next time it works." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Troubleshooting" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Text="• “Spotify rejected the Client ID”: open Settings and paste the keys again from developer.spotify.com/dashboard. The account that owns the app needs Premium." />
                                    <TextBlock TextWrapping="Wrap" Text="• An album isn't found: use fewer words (artist + main title), check the spelling, or add it without a link." />
                                    <TextBlock TextWrapping="Wrap" Text="• Text on a photo is read wrong: use good light and shoot the page straight on. Install Spanish text recognition from the Magazine photo page for accents and ñ." />
                                    <TextBlock TextWrapping="Wrap" Text="• Sync shows a warning: point at the Sync icon for the reason. Usually it's no internet, or the security rules weren't published in Firebase." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/Queueify.svg" Width="72" Height="72" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="About Queueify" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="AboutVersion" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="AboutTagline" TextWrapping="Wrap" />
                                        <ItemsControl x:Name="AboutCredits" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <Button Content="Open data folder" Click="OnOpenDataFolder"
                                                    ToolTipService.ToolTip="Your queue, settings and layout live here" />
                                        </StackPanel>
                                        <TextBlock x:Name="AboutDataPath" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings: sections of cards, like Windows Settings -->
                    <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Padding="4,8,16,8">
                        <!-- A star column with a maximum keeps the cards left-aligned under the page title. -->
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="1000" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Music services" Style="{StaticResource SettingsSection}" Margin="0,0,0,4" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"
                                       Text="Queueify searches Tidal and Spotify with free developer keys of your own. One service is enough; both is best." />
                            <controls:ServiceCard x:Name="TidalCard" Service="Tidal" DashboardUrl="https://developer.tidal.com/dashboard"
                                                  Steps="1. Open the Tidal developer dashboard and log in.&#x0a;2. Create an app (any name).&#x0a;3. Copy its Client ID and Client secret here."
                                                  SaveRequested="OnSaveServiceKeys" RemoveRequested="OnRemoveServiceKeys" />
                            <controls:ServiceCard x:Name="SpotifyCard" Service="Spotify" DashboardUrl="https://developer.spotify.com/dashboard"
                                                  Steps="1. Open the Spotify developer dashboard and log in with your Premium account.&#x0a;2. Create an app: any name and description, Redirect URI http://127.0.0.1:8888/callback (required, but unused), tick &quot;Web API&quot;.&#x0a;3. Open the app's settings and copy the Client ID and Client secret here."
                                                  SaveRequested="OnSaveServiceKeys" RemoveRequested="OnRemoveServiceKeys" />

                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE768;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Play opens albums in" />
                                        <TextBlock Text="When an album is on both services" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="PreferredBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="PreferredBox" AutomationProperties.Name="Play opens albums in"
                                              SelectionChanged="OnPreferredChanged">
                                        <x:String>Tidal</x:String>
                                        <x:String>Spotify</x:String>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE909;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Country" />
                                        <TextBlock Text="Searches show what's available in this country. Only countries where Tidal and Spotify both work are listed."
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CountryBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                              DisplayMemberPath="Name" MaxDropDownHeight="420"
                                              AutomationProperties.AutomationId="CountryBox" AutomationProperties.Name="Country"
                                              SelectionChanged="OnCountryChanged" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Appearance" Style="{StaticResource SettingsSection}" />
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE790;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Theme" />
                                        <TextBlock Text="Light or dark; by default the same as Windows" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="ThemeBox" AutomationProperties.Name="Theme"
                                              SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="Use Windows setting" Tag="system" />
                                        <ComboBoxItem Content="Light" Tag="light" />
                                        <ComboBoxItem Content="Dark" Tag="dark" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE737;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Layout" />
                                        <TextBlock Text="Brings back the Add albums panel at its first width, the list view, the original order (oldest first) and the window size"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Reset layout" Click="OnResetLayout" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Sync between your PCs" Style="{StaticResource SettingsSection}" />
                            <Border Style="{StaticResource SettingRow}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="SettingsSyncIcon" Glyph="&#xE895;" FontSize="20" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Google Firebase" />
                                        <TextBlock x:Name="SettingsSyncStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Open sync" Click="OnSync" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                                <TextBlock x:Name="SettingsDataPath" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                <HyperlinkButton Content="Open data folder" Click="OnOpenDataFolder" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Toast with Undo -->
                    <InfoBar x:Name="Toast" Grid.Row="2" IsClosable="True" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                             MaxWidth="620" Margin="0,0,0,16" Severity="Success" />
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Quick tour: one tip that moves from control to control -->
        <TeachingTip x:Name="Tour" Grid.Row="1" IsLightDismissEnabled="False" PreferredPlacement="Auto"
                     ActionButtonContent="Next" CloseButtonContent="Skip tour"
                     ActionButtonClick="OnTourNext" CloseButtonClick="OnTourClosed" />
    </Grid>
</Window>
