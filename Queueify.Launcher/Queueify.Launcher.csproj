<Project Sdk="Microsoft.NET.Sdk">
  <!-- The exe users download: a small starter with the app appended to it, compressed (ADR-0008). It
       unpacks the app once per version into %LOCALAPPDATA%\Queueify\app and starts it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>Queueify.Launcher</RootNamespace>
    <AssemblyName>Queueify.Launcher</AssemblyName>
    <ApplicationIcon>..\Queueify\Assets\Queueify.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.5.1</Version>
    <Product>Queueify</Product>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Load the exe's own imports (bcrypt.dll isn't a KnownDLL) from System32 only, never from the folder
         the download sits in, where someone else could have dropped a dll of that name. -->
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>
</Project>
