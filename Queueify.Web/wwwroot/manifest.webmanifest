{
  "name": "Queueify",
  "short_name": "Queueify",
  "description": "Your listen-later queue of albums from magazines.",
  "id": "/",
  "start_url": "/add",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#14111B",
  "theme_color": "#6544E6",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add", "url": "/add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "To listen", "url": "/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
