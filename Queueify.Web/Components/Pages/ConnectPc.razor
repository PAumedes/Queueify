@page "/connect"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Queueify.Web.Services
@using Queueify.Web.Sync
@inject PersonalAccessTokens Tokens
@inject Reauthentication Reauth
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject IConfiguration Config

<PageTitle>@Loc.T("connect.title") - Queueify</PageTitle>

<header class="q-head">
    <span class="q-head-ico"><Ico Name="connect" /></span>
    <div>
        <h1>@Loc.T("connect.title")</h1>
        <p class="q-sub">@Loc.T("connect.intro")</p>
    </div>
</header>

<div class="q-add">
    @if (_connectText != null)
    {
        <div class="q-alert warn" role="alert">
            <Ico Name="warn" />
            <div class="q-field">
                <p>@Loc.T("connect.once")</p>
                <label for="connect-text">@Loc.T("connect.text")</label>
                <input id="connect-text" class="q-input" readonly value="@_connectText" onfocus="this.select()" />
            </div>
        </div>
    }

    @if (_limitReached)
    {
        <div class="q-alert bad" role="alert"><Ico Name="warn" /><p>@Loc.T("connect.limit")</p></div>
    }

    @if (_wrongPassword)
    {
        <div class="q-alert bad" role="alert"><Ico Name="warn" /><p>@Loc.T("web.acct.m.bad_pw")</p></div>
    }

    <form class="q-card stack" @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <div class="q-field">
            <label for="token-name">@Loc.T("connect.name")</label>
            <input id="token-name" class="q-input" maxlength="@PersonalAccessTokens.MaxNameLength" @bind="_name" @bind:event="oninput" />
        </div>
        <div class="q-field">
            <label for="token-password">@Loc.T("web.acct.password")</label>
            <input id="token-password" type="password" class="q-input" autocomplete="current-password" @bind="_password" />
        </div>
        <button type="submit" class="q-btn primary" disabled="@(string.IsNullOrWhiteSpace(_name))"><Ico Name="add" />@Loc.T("connect.create")</button>
    </form>

    <h2>@Loc.T("connect.tokens")</h2>
    @if (_tokens.Count == 0)
    {
        <p class="q-meta">@Loc.T("connect.empty")</p>
    }
    else
    {
        <ul class="q-list">
            @foreach (var token in _tokens)
            {
                <li class="q-row" style="grid-template-columns: minmax(0, 1fr) auto">
                    <div>
                        <div class="q-title">@token.Name</div>
                        <div class="q-meta">@Loc.T("connect.created"): @token.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</div>
                        <div class="q-meta">@Loc.T("connect.last_used"): @(token.LastUsedAt is DateTime used ? used.ToString("yyyy-MM-dd HH:mm") + " UTC" : Loc.T("connect.never"))</div>
                    </div>
                    <div class="q-actions">
                        @if (token.RevokedAt != null)
                        {
                            <span class="q-pill state">@Loc.T("connect.revoked")</span>
                        }
                        else
                        {
                            <button type="button" class="q-btn" @onclick="() => RevokeAsync(token.Id)"><Ico Name="trash" />@Loc.T("connect.revoke")</button>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>
@code {
    private IReadOnlyList<PersonalAccessToken> _tokens = [];
    private string _name = "";
    private string? _connectText;
    private bool _limitReached;
    private bool _wrongPassword;
    private string _password = "";
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        _userId = (await Auth.GetAuthenticationStateAsync()).User.UserId();
        await LoadAsync();
    }

    private async Task LoadAsync() => _tokens = _userId == null ? [] : await Tokens.ListAsync(_userId);

    private async Task CreateAsync()
    {
        if (_userId == null || string.IsNullOrWhiteSpace(_name)) return;
        _limitReached = false;
        // A token outlives this session, so a session alone cannot make one.
        var password = _password;
        _password = "";
        _wrongPassword = !await Reauth.ConfirmPasswordAsync(_userId, password);
        if (_wrongPassword) return;
        try
        {
            var created = await Tokens.CreateAsync(_userId, _name);
            _connectText = SyncConnect.Format(PublicUrl.Of(Config) ?? Navigation.BaseUri, created.Token);
            _name = "";
        }
        catch (InvalidOperationException)
        {
            _limitReached = true;
        }
        await LoadAsync();
    }

    private async Task RevokeAsync(Guid id)
    {
        if (_userId == null) return;
        await Tokens.RevokeAsync(_userId, id);
        _connectText = null;
        await LoadAsync();
    }
}
