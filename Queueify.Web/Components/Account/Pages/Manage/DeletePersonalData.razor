@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Queueify.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger
@inject Queueify.Web.Sync.SyncEngine Engine

<PageTitle>@Loc.T("web.acct.delete.title")</PageTitle>

<StatusMessage Message="@message" />

<h3>@Loc.T("web.acct.delete.title")</h3>

<div class="q-alert warn" role="alert">
    <p>
        <strong>@Loc.T("web.acct.delete.warn")</strong>
    </p>
</div>

<div>
    <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="q-field-error" role="alert" />
        @if (requirePassword)
        {
            <div class="q-field">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="q-input" autocomplete="current-password" aria-required="true" placeholder="@Loc.T("web.acct.enterpass")" />
                <label for="Input.Password">@Loc.T("web.acct.password")</label>
                <ValidationMessage For="() => Input.Password" class="q-field-error" />
            </div>
        }
        <button class="q-btn danger wide" type="submit">@Loc.T("web.acct.delete.btn")</button>
    </EditForm>
</div>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = "Error: " + Loc.T("web.acct.m.bad_pw");
            return;
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred deleting user.");
        }

        await SignInManager.SignOutAsync();

        var userId = await UserManager.GetUserIdAsync(user);
        // The account is gone, so is everything kept for it: queue, settings, keys, preferences.
        try { await Engine.DeleteUserDataAsync(userId); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            // The account is already gone and its sync tokens with it, so nothing can write there any more.
            Logger.LogWarning(ex, "Could not remove the data folder of deleted user {UserId}.", userId);
        }
        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
