<StatusMessage Message="@StatusMessage" />
<h3>@Loc.T("web.acct.recov.codes")</h3>
<div class="q-alert warn" role="alert">
    <p>
        <strong>@Loc.T("web.acct.recov.safe")</strong>
    </p>
    <p>
        @Loc.T("web.acct.recov.lose")
    </p>
</div>
<div class="q-form-row">
    <div class="q-col">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
