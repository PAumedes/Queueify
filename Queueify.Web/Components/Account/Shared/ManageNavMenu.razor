@using Microsoft.AspNetCore.Identity
@using Queueify.Web.Data

@inject SignInManager<ApplicationUser> SignInManager

<ul class="q-subnav">
    <li><NavLink href="Account/Manage" Match="NavLinkMatch.All">@Loc.T("web.auth.nav.profile")</NavLink></li>
    <li><NavLink href="Account/Manage/Email">@Loc.T("web.auth.nav.email")</NavLink></li>
    <li><NavLink href="Account/Manage/ChangePassword">@Loc.T("web.auth.nav.password")</NavLink></li>
    @if (hasExternalLogins)
    {
        <li><NavLink href="Account/Manage/ExternalLogins">@Loc.T("web.auth.nav.external")</NavLink></li>
    }
    <li><NavLink href="Account/Manage/TwoFactorAuthentication">@Loc.T("web.auth.nav.2fa")</NavLink></li>
    <li><NavLink href="Account/Manage/Passkeys">@Loc.T("web.auth.nav.passkeys")</NavLink></li>
    <li><NavLink href="Account/Manage/PersonalData">@Loc.T("web.auth.nav.data")</NavLink></li>
</ul>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
