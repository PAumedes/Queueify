@inherits LayoutComponentBase

<a class="q-skip" href="@(Nav.Uri)#main">@Loc.T("web.nav.skip")</a>

<AuthorizeView>
    <Authorized>
        <div class="q-shell">
            <NavMenu />
            <main id="main" class="q-main" tabindex="-1">
                <div class="q-page">@Body</div>
            </main>
        </div>
        <Snackbar />
    </Authorized>
    <NotAuthorized>
        <div class="q-bare">
            <main id="main" class="q-auth">
                <div class="q-auth-brand">
                    <img src="icons/icon-192.png" alt="" width="44" height="44" />
                    <h2>Queueify</h2>
                </div>
                <div class="q-card stack">@Body</div>
            </main>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    @Loc.T("web.error.unhandled")
    <a href="." class="reload">@Loc.T("web.error.reload")</a>
    <span class="dismiss" role="button" aria-label="@Loc.T("web.toast.dismiss")">x</span>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
}

