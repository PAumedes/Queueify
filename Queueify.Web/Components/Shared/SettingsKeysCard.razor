@using Queueify.Services
@using Queueify.Web.Services

<div class="keys" data-service="@Service">
    <h3>@Name <span class="q-pill state @(Configured ? "configured" : "missing")"><span aria-hidden="true">@(Configured ? "✓ " : "○ ")</span>@Loc.T(Configured ? "webSettings.keys.on" : "webSettings.keys.off")</span></h3>
    <details>
        <summary>@Loc.T("webSettings.steps")</summary>
        <p class="steps">@Steps</p>
    </details>

    <div class="field">
        <label for="@Service-id">@Loc.T("webSettings.client_id")</label>
        <input id="@Service-id" class="q-input" type="text" autocomplete="off" spellcheck="false" maxlength="300"
               @bind="ClientId" @bind:after="() => ClientIdChanged.InvokeAsync(ClientId)" />
    </div>
    <div class="field">
        <label for="@Service-secret">@Loc.T("webSettings.client_secret")</label>
        <input id="@Service-secret" class="q-input" type="password" autocomplete="new-password" spellcheck="false" maxlength="300"
               placeholder="@Loc.T(Configured ? "webSettings.secret.saved" : "webSettings.secret.empty")"
               @bind="Secret" @bind:event="oninput" @bind:after="() => SecretChanged.InvokeAsync(Secret)" />
    </div>

    <div class="actions">
        <button type="button" class="q-btn test-@Service" disabled="@Testing" @onclick="OnTest">
            @(Testing ? Loc.T("webSettings.testing") : Loc.F("webSettings.test", Name))
        </button>
        @if (Configured)
        {
            <button type="button" class="q-btn remove-@Service" @onclick="OnRemove">@Loc.F("webSettings.remove", Name)</button>
        }
    </div>
    <p class="notice @(Result?.IsError == true ? "error" : "")" role="status" aria-live="polite" data-status="@Service">@(Result is null ? "" : (Result.IsError ? "⚠︎ " : "✓ ") + Result.Text)</p>
</div>

@code {
    [Parameter, EditorRequired] public string Service { get; set; } = "";
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Steps { get; set; } = "";
    [Parameter] public bool Configured { get; set; }
    [Parameter] public bool Testing { get; set; }
    [Parameter] public Notice? Result { get; set; }
    [Parameter] public string ClientId { get; set; } = "";
    [Parameter] public EventCallback<string> ClientIdChanged { get; set; }
    [Parameter] public string Secret { get; set; } = "";
    [Parameter] public EventCallback<string> SecretChanged { get; set; }
    [Parameter] public EventCallback OnTest { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
}
